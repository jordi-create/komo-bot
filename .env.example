# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GMI Cloud API Key (dari dashboard GMI)
GMI_API_KEY=your_gmi_api_key_here

# Whitelist Telegram User IDs (comma separated)
# Cara dapet ID: chat @userinfobot di Telegram
ALLOWED_USER_IDS=123456789,987654321

# Admin IDs (bisa /add /remove /list). Kalau kosong, pakai ALLOWED_USER_IDS.
ADMIN_USER_IDS=123456789

# Google Places API key (opsional, buat fitur cari tempat/restoran)
GOOGLE_PLACES_API_KEY=

# Tavily — search API buat bot AI (UTAMA buat web_search). Gratis ~1000 query/bulan, tanpa kartu.
# Daftar di https://tavily.com > login > copy API key (format: tvly-...).
# Kalau kosong, web_search otomatis pake DuckDuckGo (gratis, tanpa key).
TAVILY_API_KEY=

# Google Custom Search (opsional, cadangan). CATATAN: di akun org bisa keblokir org policy (403).
# API key: console.cloud.google.com > enable "Custom Search API" > Credentials.
# CX (Search Engine ID): programmablesearchengine.google.com > bikin engine, set "Search the entire web".
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Upstash Redis (WAJIB buat deploy ke Vercel — nyimpen chat, notes, reminder)
# Ambil dari dashboard Upstash > database > "REST API"
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Secret buat proteksi endpoint /api/cron (bebas isi random string)
CRON_SECRET=ganti_dengan_string_acak
